# ==============================================================================
# JokerArena · Frontend web SSR (Next.js) — variables de entorno
# Copiar a .env para desarrollo local (o exportarlas en la shell).
# ==============================================================================

# URL del API Gateway que usa el SERVIDOR de Next para renderizar (SSR).
#   · Local sin Docker:  http://localhost:8080
#   · Docker Compose:    http://jokerarena-gateway:8080
GATEWAY_INTERNAL_URL=http://localhost:8080

# URL pública del WebSocket del juego que usa el NAVEGADOR.
# Vacío = ws://<host-actual>:8080 (el gateway publicado). En despliegues con
# otro host/puerto o TLS: wss://juego.ejemplo.com/ws (sin barra final).
NEXT_PUBLIC_GATEWAY_WS_URL=

# Puerto publicado del contenedor (compose.yml)
WEB_PORT=3000
