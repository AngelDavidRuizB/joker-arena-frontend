# ==============================================================================
# JokerArena · Frontend web SSR (Next.js) — variables de entorno
# Solo son necesarias para desarrollo local (con Docker, compose.yml las define).
# Copiar a .env o exportarlas en la shell.
# ==============================================================================

# URL del API Gateway que usa el SERVIDOR de Next para renderizar (SSR).
#   · Desarrollo local (gateway publicado con docker-compose.debug.yml): http://localhost:8080
#   · Docker Compose del proyecto (P3): http://jokerarena-gateway:8080  ← valor por defecto del compose
GATEWAY_INTERNAL_URL=http://localhost:8080

# URL pública del WebSocket del juego que usa el NAVEGADOR.
# Vacío = mismo origen de la página (wss://localhost/ws/... a través del reverse proxy del P3).
# Solo se define si el WebSocket se sirve desde otro host/puerto (sin barra final).
NEXT_PUBLIC_GATEWAY_WS_URL=
